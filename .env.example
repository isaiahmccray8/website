SITE_URL=http://localhost:3000
# Your Cal.com link after cal.com/ (e.g. isaiahmccray/15min)
NEXT_PUBLIC_CAL_LINK=isaiahmccray/15min
NEXT_PUBLIC_PHONE=7042949434
NEXT_PUBLIC_EMAIL=isaiahmccray8@gmail.com

# ---- Promo codes: CODE:percent, comma separated ----
